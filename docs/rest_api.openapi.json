  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "QueueItem": {
        "type": "object",
        "required": [
          "position",
          "title",
          "artist",
          "album",
          "is_current"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "is_current": {
            "type": "boolean"
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "playback_state",
          "position_ms",
          "duration_ms",
          "current_track",
          "queue_length",
          "queue_revision"
        ],
        "properties": {
          "playback_state": {
            "type": "string",
            "enum": [
              "playing",
              "paused",
              "stopped"
            ]
          },
          "position_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "current_track": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/QueueItem"
              }
            ]
          },
          "queue_length": {
            "type": "integer",
            "minimum": 0
          },
          "queue_revision": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Queue": {
        "type": "object",
        "required": [
          "revision",
          "current_track",
          "items"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "current_track": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/QueueItem"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItem"
            }
          }
        }
      },
      "PlaybackRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "play",
              "pause",
              "stop",
              "next"
            ]
          }
        }
      },
      "QueueOrderRequest": {
        "type": "object",
        "required": [
          "revision",
          "order"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "order": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Complete permutation of the zero-based positions from GET /queue."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
